generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  masterKey    String   // será usada para criptografar dados do usuário
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
